# Optional locally when using the ignored firebase-key.json; set to compact JSON on the host.
FIREBASE_CREDENTIALS=
# Generate a random secret and keep it stable between deploys.
FLASK_SECRET_KEY=generate-a-long-random-secret
# Configure a Google OAuth web client with this exact callback URI.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-cloudflare-access-key
R2_SECRET_KEY=your-cloudflare-secret-key
R2_BUCKET_NAME=your-cloudflare-bucket-name
R2_PUBLIC_URL=https://your-public-r2-domain
